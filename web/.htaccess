RewriteEngine On
RewriteBase /

# One host for search engines: www and plain http answer with a permanent
# redirect to https://ronipaschoal.com.br, keeping the path. Otherwise each
# variant is indexed as a duplicate of the same page. The X-Forwarded-Proto
# check avoids a redirect loop if HTTPS is ever terminated by a proxy.
RewriteCond %{HTTP_HOST} ^www\. [NC,OR]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://ronipaschoal.com.br%{REQUEST_URI} [L,R=301]

# Each route has its own static entry page, written by tool/seo_content.dart
# with that page's language, title, description, canonical URL, hreflang and
# Open Graph tags, so crawlers and link previews (which don't run JS) see the
# right ones:
#   /       → index.html    /en     → en.html
#   /cv     → cv.html       /en/cv  → en-cv.html
# Flat files rather than an `en/` folder, which Apache would redirect to
# `/en/`. Asking for a .html name (or `/en/`) redirects to the clean URL, so
# every page has a single URL.
RewriteCond %{THE_REQUEST} \s/cv\.html[\s?]
RewriteRule ^ /cv [L,R=301]
RewriteCond %{THE_REQUEST} \s/en\.html[\s?]
RewriteRule ^ /en [L,R=301]
RewriteCond %{THE_REQUEST} \s/en-cv\.html[\s?]
RewriteRule ^ /en/cv [L,R=301]
RewriteRule ^en/$ /en [L,R=301]
RewriteRule ^en/cv/$ /en/cv [L,R=301]
RewriteRule ^cv$ cv.html [L]
RewriteRule ^en$ en.html [L]
RewriteRule ^en/cv$ en-cv.html [L]

# Flutter uses path URLs (`/cv`), which only exist inside the app: serve
# index.html for any path that isn't a real file or folder, so deep links
# and reloads work.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# The WebAssembly build (`flutter build web --wasm`) fails to start unless
# .wasm is served as application/wasm and .mjs as JavaScript; spelled out
# here so it doesn't depend on the host's mime.types.
AddType application/wasm .wasm
AddType text/javascript .mjs
AddType image/webp .webp

# Every page is UTF-8 (index.html and cv.html also declare it in a meta tag);
# saying so in the Content-Type header too means crawlers never have to guess.
AddDefaultCharset UTF-8
